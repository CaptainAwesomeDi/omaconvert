#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1 && qmake -query QT_VERSION | grep -q '^6\.'; then
  QMAKE=qmake
else
  echo "A Qt 6 qmake (qmake6) is required to build omaunits." >&2
  exit 1
fi

JOBS="$(nproc 2>/dev/null || echo 1)"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"
"$QMAKE" "$ROOT/omaunits.pro"
# qmake's rcc rule keys off the .qrc file, not the QML it lists; without
# this touch, QML-only edits silently ship the previous resources.
touch "$ROOT/src/resources.qrc"
make -j"$JOBS"

echo "Built $BUILD_DIR/omaunits"
